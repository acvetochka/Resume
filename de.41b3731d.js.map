$ad567fbd23d2c857$exports = JSON.parse('[{"position":"FullStack Entwicklerin","date":"06/2025 - heute","company":"DoGood Impact Inc.","place":"USA (Remote)","duties":["Entwickelte und optimierte skalierbare Frontend- und Backend-Komponenten f\xfcr eine internationale Non-Profit-Plattform und stellte eine stabile sowie wartbare Anwendungsarchitektur sicher.","Konzipierte und implementierte Schnittstellen zwischen Frontend und Backend, um eine konsistente Datenstruktur und zuverl\xe4ssige Datenkommunikation sicherzustellen.","Erstellte und pflegte die technische Projektdokumentation und erleichterte dadurch Wartung sowie Wissensaustausch im Team.","Automatisierte die API-Dokumentation und wiederkehrende Entwicklungsaufgaben, wodurch manuelle Prozesse reduziert wurden.","Arbeitete eng mit Frontend-, Backend- und Design-Teams bei der Entwicklung eines MVP zusammen und beteiligte sich aktiv an Sprint Planning, Refinements und Code Reviews.","Entwickelte eigenst\xe4ndig technische L\xf6sungen und stellte Qualit\xe4t sowie Stabilit\xe4t der entwickelten Komponenten sicher."],"technologies":["React","Next.js","TypeScript","Tailwind CSS","PostgreSQL","Prisma","VitePress","Swagger","GitHub Actions"]},{"position":"Frontend Entwicklerin","company":"SoftRyzen","place":"Kiew, Ukraine","date":"11/2023 - 12/2023","duties":["Entwickelte interaktive Benutzeroberfl\xe4chen f\xfcr die Website eines kommerziellen Kunden und sorgte f\xfcr eine intuitive Benutzerf\xfchrung.","Implementierte dynamische Tab-Komponenten f\xfcr die Bereiche \u201EVorteile\u201C und \u201EFAQ\u201C und verbesserte dadurch die Interaktivit\xe4t der Website.","Entwickelte wiederverwendbare UI-Komponenten, passte die Tailwind-Konfiguration an und stellte ein konsistentes Design sicher.","Analysierte und behob Cross-Browser-Kompatibilit\xe4tsprobleme, um eine stabile Darstellung auf unterschiedlichen Browsern und Endger\xe4ten zu gew\xe4hrleisten.","Arbeitete eng mit Entwicklern und Designern im Scrum-Team zusammen und trug zur termingerechten Umsetzung der Projektziele bei."],"reference":{"website":"https://smile-bar.vercel.app","github":"https://github.com/SoftRyzen-internship/smile_bar"},"technologies":["React","Next.js","Tailwind CSS","Figma","Trello"]}]');


var $a33b331cdf732c5f$exports = {};
$a33b331cdf732c5f$exports = JSON.parse("[{\"title\":\"Portfolio\",\"src\":\"https://kuznietsova.org\",\"github\":\"https://github.com/acvetochka/portfolio\",\"technologies\":[\"Next.js\",\"React\",\"TypeScript\",\"Styled Components\",\"EmailJS\",\"MailboxLayer API\",\"Yup\",\"Git\",\"Vercel\"],\"description\":[\"Developed a responsive portfolio website using <b>Next.js</b>, <b>React</b>, and <b>TypeScript</b> to showcase projects and technical skills.\",\"Built reusable <b>React components</b> and implemented modern animations with <b>Styled Components</b> to create a consistent and maintainable UI.\",\"Developed a secure contact form featuring <b>multi-step validation</b>, <b>spam detection</b>, <b>email verification</b>, and automated message delivery via external <b>REST APIs</b>.\",\"Ensured <b>cross-browser compatibility</b> while optimizing application performance and page load times across different browsers and devices.\",\"Deployed and continuously maintained the application on <b>Vercel</b>, including the configuration of automated <b>deployment workflows</b>.\",\"Achieved a <b>Lighthouse score of 100/100</b> in Performance, Accessibility, Best Practices, and SEO.\"],\"date\":[\"10/2024 - Present\"]},{\"title\":\"Car Rental\",\"src\":\"https://acvetochka.github.io/car-rental\",\"github\":\"https://github.com/acvetochka/car-rental\",\"technologies\":[\"React\",\"Redux Toolkit\",\"React Router\",\"Axios\",\"Framer Motion\",\"Emotion Styles\",\"GitHub Actions\",\"GitHub Pages\"],\"description\":[\"Developed a responsive <b>React</b> web application for vehicle search and reservation using a component-based architecture.\",\"Managed application state with <b>Redux Toolkit</b> and integrated a <b>REST API</b> using <b>Axios</b> to dynamically display and filter vehicle data.\",\"Implemented interactive search and filtering features, a favorites system with <b>Local Storage</b> persistence, and a modal-based vehicle details view.\",\"Built a responsive user interface and implemented modern animations using <b>Emotion</b> and <b>Framer Motion</b> to ensure a consistent user experience across different devices.\",\"Configured an automated <b>CI/CD</b> workflow with <b>GitHub Actions</b> to deploy the application to <b>GitHub Pages</b>.\"],\"date\":[\"10/2023 - 11/2023\"]},{\"title\":\"Goose Track\",\"src\":\"https://nazarmural.github.io/goose-track-project/\",\"github\":\"https://github.com/acvetochka/goose-track-project\",\"technologies\":[\"React\",\"Redux Toolkit\",\"React Router\",\"Axios\",\"Trello\",\"Git\",\"GitHub\"],\"text\":[\"Full-Stack Team Project\",\"Role: Frontend Team Lead, Scrum Master, Frontend Developer.\"],\"description\":[\"Developed a responsive <b>React</b> web application for personal task and calendar management with <b>Google Authentication</b> as part of a full-stack team project.\",\"Implemented core monthly calendar functionality, including the user interface, interaction logic, and state management with <b>Redux Toolkit</b>, while collaborating closely with the backend team on <b>REST API</b> integration and issue resolution.\",\"Led a frontend <b>team of 9 developers</b>, conducted <b>Code Reviews</b>, and ensured consistent development standards and code quality.\",\"Served as <b>Scrum Master</b>, organizing the development workflow with <b>Trello</b>, facilitating <b>Agile ceremonies</b>, and coordinating collaboration across the frontend team.\"],\"date\":[\"09/2023 - 10/2023\"]},{\"title\":\"Phonebook\",\"src\":\"https://acvetochka.github.io/Phonebook/\",\"github\":\"https://github.com/acvetochka/Phonebook\",\"technologies\":[\"React\",\"Redux Toolkit\",\"Axios\",\"Node.js\",\"Express\",\"MongoDB\",\"REST API\",\"DigitalOcean\"],\"text\":[\"Full-Stack App\"],\"description\":[\"Developed a responsive contact management web application using <b>React</b> and <b>Redux Toolkit</b> with an intuitive and user-friendly interface.\",\"Designed and implemented a <b>RESTful API</b> using <b>Node.js</b>, <b>Express</b>, and <b>MongoDB</b> to handle user authentication, contact management, and persistent data storage.\",\"Integrated the frontend with the <b>REST API</b> using <b>Axios</b> and managed application state with <b>Redux Toolkit</b>.\",\"Implemented <b>CRUD</b> functionality for creating, updating, deleting, and filtering contacts, while ensuring a responsive user experience across different devices.\",\"Deployed the backend to a <b>DigitalOcean</b> server, including server environment configuration and application deployment.\"],\"date\":[\"07/2023 - Present\"]}]");


