$bde8d0f24dd387c8$exports = JSON.parse("[{\"position\":\"Full-Stack Developer\",\"date\":\"06/2025 - Present\",\"company\":\"DoGood Impact Inc.\",\"place\":\"USA (Remote)\",\"duties\":[\"Developed and optimized scalable frontend and backend components using <b>React</b>, <b>Next.js, TypeScript, PostgreSQL</b>, and <b>Prisma</b> for an international non-profit platform.\",\"Designed and implemented interfaces between frontend and backend to ensure consistent data structures and reliable data communication.\",\"Created and maintained technical project documentation (architecture, API, data flows) using <b>VitePress</b>, improving maintainability and knowledge sharing across the team.\",\"Automated <b>API documentation</b> by implementing <b>CI/CD</b> workflows with <b>GitHub Actions</b> and <b>Swagger</b>, reducing manual effort and increasing development efficiency.\",\"Developed <b>automation scripts</b> for recurring tasks (e.g., component and icon exports) to streamline the development workflow.\",\"Collaborated closely with frontend, backend, and design teams on the development of an <b>MVP</b>, participating in <b>Sprint Planning</b>, <b>Refinement sessions</b>, and <b>Code Reviews</b>.\",\"Continuously improved the scalability, maintainability, and reusability of the application architecture.\",\"Independently delivered technical solutions while ensuring the quality, reliability, and stability of the developed components.\"],\"technologies\":[\"React\",\"Next.js\",\"TypeScript\",\"Tailwind CSS\",\"PostgreSQL\",\"Prisma\",\"VitePress\",\"Swagger\",\"GitHub Actions\"]},{\"position\":\"Frontend Developer\",\"company\":\"SoftRyzen\",\"place\":\"Kyiv, Ukraine (remote)\",\"date\":\"11/2023 - 12/2023\",\"duties\":[\"Developed interactive user interfaces for the website of a commercial client (SmileBar) using <b>React</b>, <b>Next.js</b>, and <b>Tailwind CSS</b>, ensuring an intuitive user experience.\",\"Implemented dynamic <b>tab components</b> for the Benefits and FAQ sections to improve usability and interactivity.\",\"Customized the <b>Tailwind CSS</b> configuration and developed reusable <b>UI components</b> and animations to ensure a consistent design system.\",\"Analyzed and resolved <b>cross-browser compatibility</b> issues to ensure consistent behavior across different browsers and devices.\",\"Collaborated with developers and designers in an <b>Agile Scrum</b> team using <b>Figma</b> and <b>Trello</b> to deliver project milestones on schedule.\",\"Independently delivered assigned frontend tasks while maintaining high code quality and meeting project requirements.\"],\"reference\":[\"https://smile-bar.vercel.app\",\"https://github.com/SoftRyzen-internship/smile_bar\"],\"technologies\":[\"React\",\"Next.js\",\"Tailwind CSS\",\"Figma\",\"Trello\"]}]");


